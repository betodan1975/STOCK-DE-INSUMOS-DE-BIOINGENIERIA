):
    for key, val in [
        ("fx_rate", payload.fx_rate),
        ("threshold_pct", payload.threshold_pct),
        ("servicios", payload.servicios),
    ]:
        row = db.get(models.Config, key)
        if row:
            row.value = json.dumps(val)
